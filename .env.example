# Firebase Admin Configuration (Server-side Firestore persistence)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Resend API Configuration (Server-side notification delivery)
RESEND_API_KEY=
CONTACT_RECIPIENT_EMAIL=
CONTACT_SENDER_EMAIL=
